    },
    {
      "label": "근거 없는 경쟁 비교 또는 범용 연동 보장",
      "scope": "all",
      "pattern": "업계\\s*최고|경쟁사(와|에|들)?\\s*(대비|비해|보다)[^.!?\\n]{0,25}(우수|우월|낫|뛰어나|정확|빠르)|모든\\s*[^.!?\\n]{0,30}(CRM|ERP|전화\\s*환경|전화\\s*시스템)(에서|에|과|와|까지)?[^.!?\\n]{0,15}(연동|호환)"
    },
    {
      "label": "고객사 예시 화면 수치 사용 의심",
      "scope": "tlink",
      "pattern": "(?<![\\d.,])(115\\s*건|108\\s*건|6\\s*건|9\\s*개\\s*(의\\s*)?VOC|78\\s*점)"
    },
    {
      "label": "요금 언급",
      "scope": "tlink",
      "pattern": "(\\d[\\d,]*\\s*만\\s*원|\\d[\\d,]*\\s*원\\s*/\\s*월|월\\s*\\d[\\d,]*\\s*(만\\s*)?원|요금|설정비|부가세\\s*별도|VAT)"
    },
    {
      "label": "근거 없는 기능(SHA256)",
      "scope": "tlink",
      "pattern": "SHA\\s*-?\\s*256"
    },
    {
