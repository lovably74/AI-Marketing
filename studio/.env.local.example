# T-LINK AI Marketing Studio 환경변수 예시
# 이 파일을 복사해 .env.local 을 만들고 값을 채운 뒤 서버를 다시 시작하세요.
#   cp .env.local.example .env.local
# .env.local 은 git에 올라가지 않습니다(.gitignore). 키 값은 서버에서만 읽고 브라우저로 보내지 않습니다.

# [필수] Google Gemini API 키 (기본 모델 gemini-3.8-flash 사용)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [선택] OpenAI API 키 (gpt-4o 모델을 /admin에서 켜서 쓸 때)
OPENAI_API_KEY=

# [선택] 공개 배포 주소. 비워 두면 카드뉴스 QR은 티링크 공식 보고서로 연결됩니다.
NEXT_PUBLIC_SITE_URL=

# [선택] 관리자 페이지(/admin)에서 모델을 추가·삭제·기본 지정할 때 입력하는 토큰
# 비워 두면 관리 기능(저장·연결 테스트)이 막힙니다. 추측하기 어려운 긴 문자열을 쓰세요.
ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────
# [선택] 고객 메일 발송(SMTP). 6개 항목이 모두 있어야 발송 기능이 켜집니다.
# 비워 두면 화면에 "SMTP 미설정"이 표시되고 발송 버튼이 비활성화됩니다(/api/email 은 503).
# 비밀번호는 서버에서만 읽고 로그·응답에 넣지 않습니다.
#
# 포트 안내
#   465 → SMTP_SECURE=true  (처음부터 SSL/TLS)
#   587 → SMTP_SECURE=false (STARTTLS로 암호화 전환)
# Gmail 예시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
#   SMTP_PASS 에는 계정 비밀번호가 아니라 "앱 비밀번호"(Google 계정 > 보안 > 2단계 인증 사용 후 앱 비밀번호 생성, 16자리)를 넣습니다.
# MAIL_FROM 의 주소는 SMTP_USER 계정(또는 그 계정에 허용된 별칭)과 같아야 스팸 처리·거부를 피할 수 있습니다.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 예: MAIL_FROM="T-LINK <sales@example.com>"
MAIL_FROM=

# [선택] DB 연결 (기본: SQLite 파일 ./.data/tlink.db — 고객 개인정보·원본 사진 포함, git 제외)
# PostgreSQL(postgres://...)은 향후 지원 예정
DATABASE_URL=sqlite:./.data/tlink.db
